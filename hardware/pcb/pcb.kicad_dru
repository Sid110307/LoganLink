(version 1)
(rule "0.2 margin outside fine-pitch parts"
	(condition "!(A.memberOfFootprint('U3') || A.memberOfFootprint('U5') || A.memberOfFootprint('U6') || A.memberOfFootprint('J2') || B.memberOfFootprint('U3') || B.memberOfFootprint('U5') || B.memberOfFootprint('U6') || B.memberOfFootprint('J2') || A.intersectsCourtyard('U3') || A.intersectsCourtyard('U5') || A.intersectsCourtyard('J2'))")
	(constraint clearance (min 0.2mm))
	(constraint track_width (min 0.2mm)))
